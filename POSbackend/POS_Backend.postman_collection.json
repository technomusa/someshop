    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{auth_token}}",
                "type": "string"
            }
        ]
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    ""
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "var jsonData = pm.response.json();",
                    "if (jsonData.token) {",
                    "    pm.environment.set(\"auth_token\", jsonData.token);",
                    "}",
                    "// Also check for token in data.token (for login response)",
                    "if (jsonData.data && jsonData.data.token) {",
                    "    pm.environment.set(\"auth_token\", jsonData.data.token);",
                    "}"
                ]
            }
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000",
            "type": "string"
        }
    ]
}